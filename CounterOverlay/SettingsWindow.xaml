<Window x:Class="CounterOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Counter Overlay - Settings"
        Height="470" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,4,8,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Increment hotkey (click the box, then press a key or mouse button):" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBox x:Name="IncrementBox" Text="F7"
                     PreviewKeyDown="IncrementBox_PreviewKeyDown"
                     PreviewMouseDown="IncrementBox_PreviewMouseDown"
                     GotFocus="HotkeyBox_GotFocus"/>

            <TextBlock Text="Reset hotkey (click the box, then press a key or mouse button):" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBox x:Name="ResetBox" Text="F8"
                     PreviewKeyDown="ResetBox_PreviewKeyDown"
                     PreviewMouseDown="ResetBox_PreviewMouseDown"
                     GotFocus="HotkeyBox_GotFocus"/>

            <TextBlock Text="Label text:"/>
            <TextBox x:Name="LabelBox" IsReadOnly="False" Cursor="IBeam" Text="Count"/>

            <TextBlock Text="Font size:"/>
            <TextBox x:Name="FontSizeBox" IsReadOnly="False" Cursor="IBeam" Text="48"/>

            <TextBlock Text="Text color (hex, e.g. #FFFFFF):"/>
            <TextBox x:Name="ColorBox" IsReadOnly="False" Cursor="IBeam" Text="#FFFFFF"/>

            <CheckBox x:Name="ClickThroughBox" Content="Click-through overlay (uncheck to drag/reposition)"
                      Foreground="#EEEEEE" Margin="0,0,0,16" IsChecked="True"/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="Save" Click="SaveButton_Click"/>
                <Button x:Name="ResetCounterButton" Content="Reset Counter Now" Click="ResetCounterButton_Click"/>
                <Button x:Name="ExitButton" Content="Exit App" Click="ExitButton_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Margin="0,12,0,0" Foreground="#88FF88"/>
        </StackPanel>
    </Grid>
</Window>
